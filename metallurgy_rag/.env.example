# Local Qwen via Ollama installed on the host. Docker Desktop on macOS and
# Windows exposes the host through host.docker.internal.
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3:8b
RAG_OLLAMA_URL=http://host.docker.internal:11434

# Common project OpenRouter configuration. When both values are set, the API
# uses this model as an independent Judge; the answer generator above stays
# local Qwen unless RAG_LLM_PROVIDER is changed explicitly.
OPENROUTER_API_KEY=keep_this_only_in_.env
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
UI_PORT=8501

# Cross-encoder filters hybrid RRF candidates before they reach LLM.
# Raise the threshold to be stricter; calibrate it against expert questions.
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RELEVANCE_THRESHOLD=0.55

# The logical collection. Leave unchanged unless you deliberately build another
# index for an experiment.
RAG_QDRANT_COLLECTION=metallurgy_search_units

# Persistent Qdrant index location. It is 11+ GB in the current project and
# is intentionally not included in the Git repository or Docker image.
QDRANT_STORAGE_PATH=./data/qdrant

# For a remote OpenAI-compatible inference server instead of Ollama:
# RAG_LLM_PROVIDER=openai-compatible
# RAG_LLM_BASE_URL=http://YOUR_SERVER:8000/v1
# RAG_LLM_API_KEY=keep_this_only_in_.env

# MetalGPT-1 is served separately through vLLM or SGLang, then selected in the
# UI as provider=openai-compatible. It is 33B BF16, so do not run it inside
# this Compose stack or on the same :8000 port as the RAG API.
# RAG_LLM_PROVIDER=openai-compatible
# RAG_LLM_MODEL=nn-tech/MetalGPT-1
# RAG_LLM_BASE_URL=http://GPU_SERVER:8001/v1
# RAG_LLM_API_KEY=

# Optional separate LLM Judge. If these values are absent, Judge uses the same
# local generator model. An OpenRouter-compatible example is below; use a
# dedicated key with a spending limit and keep it only in the untracked .env.
# RAG_JUDGE_PROVIDER=openai-compatible
# RAG_JUDGE_MODEL=~openai/gpt-latest
# RAG_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# RAG_JUDGE_API_KEY=keep_this_only_in_.env
# RAG_JUDGE_TIMEOUT=240
# RAG_JUDGE_THRESHOLD=0.82
# RAG_JUDGE_MAX_ITERATIONS=3

# If OPENROUTER_API_KEY and OPENROUTER_MODEL are set above, this model becomes
# the independent Judge automatically; the local Qwen generator remains
# unchanged. Override it with RAG_JUDGE_* if the Judge should use another model.

# Neo4j: local CLI uses the published Bolt port; Compose uses neo4j:7687.
NEO4J_URI=bolt://localhost:7690
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_DATABASE=neo4j
NEO4J_HEAP_MAX=2g

# Bound reranker memory for long candidates. Empty device = automatic choice.
RAG_RERANKER_MAX_LENGTH=1024
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_DEVICE=
RAG_EMBEDDING_DEVICE=
# Must match the model used to build the current Qdrant collection. Its vectors
# are 768-dimensional; bge-m3 is 1024-dimensional and requires reindexing.
RAG_DENSE_MODEL=intfloat/multilingual-e5-base

# Hosted MetalGPT via Hugging Face Inference Providers (fine-grained HF token).
# RAG_LLM_PROVIDER=openai-compatible
# RAG_LLM_MODEL=nn-tech/MetalGPT-1:featherless-ai
# RAG_LLM_BASE_URL=https://router.huggingface.co/v1
# RAG_LLM_API_KEY=hf_your_token
# OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
