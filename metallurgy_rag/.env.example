# Local Qwen via Ollama installed on the host. Docker Desktop on macOS and
# Windows exposes the host through host.docker.internal.
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3:8b
RAG_OLLAMA_URL=http://host.docker.internal:11434

# Cross-encoder filters hybrid RRF candidates before they reach LLM.
# Raise the threshold to be stricter; calibrate it against expert questions.
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RELEVANCE_THRESHOLD=0.55

# The logical collection. Leave unchanged unless you deliberately build another
# index for an experiment.
RAG_QDRANT_COLLECTION=metallurgy_search_units

# Persistent Qdrant index location. It is 11+ GB in the current project and
# is intentionally not included in the Git repository or Docker image.
QDRANT_STORAGE_PATH=./data/qdrant

# For a remote OpenAI-compatible inference server instead of Ollama:
# RAG_LLM_PROVIDER=openai-compatible
# RAG_LLM_BASE_URL=http://YOUR_SERVER:8000/v1
# RAG_LLM_API_KEY=keep_this_only_in_.env
