    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {"type": "text", "content": "When coke is charged to the surface of slag, oxides are reduced as given by"}
        ]
      },
      "bbox": [137, 110, 800, 140]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "(\\mathrm{Fe} _ {3} \\mathrm{O} _ {4}) + \\mathrm{C} = (3 \\mathrm{FeO}) + \\mathrm{CO} (\\mathrm{g})\\tag{[1]}",
        "math_type": "latex"
      },
      "bbox": [196, 586, 470, 606]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "(\\mathrm{Cu} _ {2} \\mathrm{O}) + \\mathrm{C} = 2 \\mathrm{Cu} (\\mathrm{l}) + \\mathrm{CO} (\\mathrm{g})\\tag{[2]}",
        "math_type": "latex"
      },
      "bbox": [196, 620, 470, 640]
    }
  ],
  [
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {"type": "text", "content": "Copper losses in slag include unsettled droplets as given by Stokes law"}
        ]
      },
      "bbox": [137, 80, 800, 110]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "u = \\frac {(\\rho_ {c u} - \\rho_ {s l a g})}{1 8 \\eta_ {s l a g}} g d ^ {2}\\tag{[4]}",
        "math_type": "latex"
      },
      "bbox": [137, 120, 500, 160]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {"type": "text", "content": "where u = settling rate, m "},
          {"type": "equation_inline", "content": "\\mathbf { S } ^ { - 1 }"}
        ]
      },
      "bbox": [137, 170, 400, 190]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "g = \\text { acceleration   due   to   gravity,   m   s } ^{-2}",
        "math_type": "latex"
      },
      "bbox": [137, 200, 500, 220]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "d = \\text { diameter   of   copper   droplet,   m }",
        "math_type": "latex"
      },
      "bbox": [137, 230, 500, 250]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {"type": "text", "content": "ρCu, ρslag = density of copper and slag respectively, kg m-3"}
        ]
      },
